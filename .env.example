# Propongo SMTP settings (enables password-reset emails)
# Copy this file to `.env` and fill in your SMTP details.
# If a `.env` file is present next to the app directory, its values are
# loaded automatically. Real environment variables always take precedence.

# Proton Mail (paid plan + custom domain) example:
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
# The username is your full sender address:
SMTP_USER=info@3point.xyz
# SMTP token generated in Settings > All settings > IMAP/SMTP > SMTP tokens
SMTP_PASS=replace-with-your-smtp-token
# From address (defaults to SMTP_USER if unset):
SMTP_FROM=info@3point.xyz

# Propongo LLM-as-judge section scoring (Scope/Qualifications/Custom Sections tabs)
#
# The default, free model option runs against a local Ollama server - fully
# private, no API key, nothing leaves your machine. One-time setup:
#   1. Install Ollama: https://ollama.com/download
#   2. Pull a model (run once from a terminal), e.g.:
#        ollama pull llama3.1
#      Any chat-capable model works; smaller ones (e.g. llama3.2, qwen2.5:7b)
#      score faster but less reliably. See https://ollama.com/library.
#   3. Make sure Ollama is running - it starts automatically after install on
#      most platforms. Check with: ollama list
# If you pulled a different model, set OLLAMA_MODEL to match its exact name
# (as shown by `ollama list`, e.g. "llama3.1:8b").
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ANTHROPIC_API_KEY only gates the paid Claude Sonnet/Opus options in the
# model dropdown; leave it unset if you only want the free local option.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
